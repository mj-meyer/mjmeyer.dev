{
  "name": "",
  "version": "2.2.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro check --watch & astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "content:sync": "bun run \"${GARDEN_PROCESSOR_DIR:-../repos/garden-processor}/src/main.ts\"",
    "astro": "astro",
    "format:check": "prettier --plugin-search-dir=. --check .",
    "format": "prettier --plugin-search-dir=. --write .",
    "cz": "cz",
    "lint": "eslint .",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:journey": "playwright test",
    "test:migration": "pnpm test:contracts && pnpm build && pnpm test:journey",
    "og:test": "node scripts/test-og-image.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/ts-plugin": "^1.10.9",
    "@astrojs/vercel": "^10.0.7",
    "astro": "^6.3.7",
    "astro-embed": "^0.13.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^0.436.0",
    "rehype-external-links": "^3.0.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^8.0.1",
    "satori": "^0.10.14",
    "sharp": "^0.34.5",
    "typescript": "^5.5.4",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/react": "^5.0.5",
    "@astrojs/sitemap": "^3.7.2",
    "@base-ui/react": "1.8.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/hast": "^3.0.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "astro-eslint-parser": "^1.4.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "lint-staged": "^13.2.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-obsidian-callout": "^1.5.1",
    "three": "0.180.0",
    "typescript-eslint": "^8.59.4",
    "yaml": "^2.9.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp"
    ]
  },
  "lint-staged": {
    "*": [
      "prettier --plugin-search-dir=. --write"
    ]
  }
}
