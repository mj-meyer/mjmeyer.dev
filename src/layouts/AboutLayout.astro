---
import { ArrowLeft, ArrowRight } from "lucide-react";
import GardenLayout from "./GardenLayout.astro";

export interface Props {
  frontmatter: {
    title: string;
    subtitle?: string;
    description?: string;
    metaTitle?: string;
    metaDescription?: string;
  };
}

const { frontmatter } = Astro.props;
const historicalNow = Astro.url.pathname.replace(/\/$/, "") === "/nowold";
const pageTitle = frontmatter.metaTitle || frontmatter.title;
const description = frontmatter.metaDescription || frontmatter.description;
---

<GardenLayout
  title={pageTitle}
  description={description}
  pageType="personal"
  active="about"
>
  <main
    id="main-content"
    class:list={["personal-page", { "historical-now-page": historicalNow }]}
    transition:animate="none"
    tabindex="-1"
  >
    <header class="personal-intro">
      <p class="personal-eyebrow">
        {historicalNow ? "Historical page" : frontmatter.subtitle || "Personal"}
      </p>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <p>{frontmatter.description}</p>}
      {
        historicalNow && (
          <>
            <p>
              This is the earlier standalone Now page, retained as part of the
              site’s history.
            </p>
            <a class="personal-text-link" href="/now">
              <ArrowRight size={15} aria-hidden="true" /> Read the dated Now
              archive
            </a>
          </>
        )
      }
    </header>
    <article class="personal-prose">
      <slot />
    </article>
    {
      historicalNow && (
        <nav
          class="personal-bottom-links"
          aria-label="Historical Now navigation"
        >
          <a href="/now">
            <ArrowLeft size={15} aria-hidden="true" /> Back to Now
          </a>
          <a href="/garden">
            Browse the garden <ArrowRight size={15} aria-hidden="true" />
          </a>
        </nav>
      )
    }
  </main>
</GardenLayout>
