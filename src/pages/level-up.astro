---
import Layout from "@layouts/LandingLayout.astro";
import { Loader2, Check, ArrowRight, TrendingUp, Baby, Plane, Briefcase } from "lucide-react";
import { Toast } from "../components/Toast";
import WaveDivider from "../components/WaveDivider.astro";

// Add this line to force server-side rendering
export const prerender = false;
---

<Layout
  title="Level Up Your Dev Career | Goal Setting System"
  description="Transform your development career with a proven goal-setting and review system built in Obsidian. Get organized, stay accountable, and level up your skills."
>
  <Fragment slot="hero">
    <h1
      class="text-4xl flex -mt-8 flex-col border-skin-accent-line uppercase max-sm:w-2/3 max-sm:text-2xl text-center md:text-5xl lg:text-7xl font-black mb-4 relative text-balance"
    >
      16 Years as a developer. <span class="underline text-skin-accent"
        >$1,170,050 Lost.</span
      >
    </h1>
    <div
      class="flex flex-row pt-16 items-center gap-8 text-center max-w-full mx-auto"
    >
      <div class="text-left flex flex-col">
        <div class="flex flex-col gap-8">
          <h2 class="text-5xl font-bold">
            Technical Debt is Visible. <span class="text-skin-accent"
              >Career Debt is Silent.</span
            >
          </h2>
          <p class="text-2xl text-balance font-montserrat font-normal">
            Are you a developer grinding away at your day job while watching
            others build thriving careers and successful side projects?
          </p>
          <p class="text-2xl text-balance font-montserrat font-normal">
            I was... and I've paid dearly for it! I'd like to help you avoid my
            mistakes.
          </p>
          <div class="flex flex-col gap-4">
            <p
              class="text-xl text-balance text-skin-accent font-montserrat font-bold"
            >
              In this FREE email course, you'll learn:
            </p>
            <ul class="flex flex-col gap-3">
              <li class="flex items-start gap-2">
                <Check
                  className="w-6 h-6 mt-1 text-skin-accent shrink-0"
                  client:only="react"
                />
                <span
                  >The exact system I use to identify life-changing
                  opportunities others miss</span
                >
              </li>
              <li class="flex items-start gap-2">
                <Check
                  className="w-6 h-6 mt-1 text-skin-accent shrink-0"
                  client:only="react"
                />
                <span
                  >How to turn your daily work into career-defining moments</span
                >
              </li>
              <li class="flex items-start gap-2">
                <Check
                  className="w-6 h-6 mt-1 text-skin-accent shrink-0"
                  client:only="react"
                />
                <span
                  >My framework for building unstoppable momentum in tech</span
                >
              </li>
              <li class="flex items-start gap-2">
                <Check
                  className="w-6 h-6 mt-1 text-skin-accent shrink-0"
                  client:only="react"
                />
                <span>The morning routine that creates "luck" on autopilot</span
                >
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div
        class="w-full max-w-md mt-6 mx-auto rounded-3xl border-dashed border-skin-accent border-2 border-t-0 relative"
      >
        <span
          class="absolute mx-auto py-2 bg-skin-accent -top-6 text-skin-inverted rounded-tl-3xl rounded-tr-3xl font-montserrat w-full text-center left-0 text-5xl font-black"
        >
          FREE <span class="text-skin-inverted/60">FOR NOW</span>
        </span>

        <form id="signup-form" class="mt-10 p-8 space-y-4">
          <div>
            <label for="firstName" class="sr-only">First Name</label>
            <input
              type="text"
              id="firstName"
              name="firstName"
              required
              class="w-full px-4 py-2 rounded-lg border bg-skin-fill border-skin-accent focus:outline-hidden focus:ring-2 focus:ring-skin-accent"
              placeholder="Enter your first name"
            />
          </div>
          <div>
            <label for="email" class="sr-only">Email address</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-2 rounded-lg border bg-skin-fill border-skin-accent focus:outline-hidden focus:ring-2 focus:ring-skin-accent"
              placeholder="Enter your email address"
            />
          </div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-skin-accent text-skin-inverted py-2 px-6 rounded-lg font-bold hover:opacity-90 transition-opacity flex items-center justify-center gap-2"
          >
            <span>Get the Free Template</span>
            <div id="spinner" class="hidden">
              <Loader2 className="w-5 h-5 animate-spin" />
            </div>
          </button>
        </form>
      </div>
    </div>
  </Fragment>

  <div class="w-full max-w-full flex flex-col">
    <!-- Hidden Cost Section -->
    <section class="relative overflow-hidden w-full max-w-full py-16">
      <div class="max-w-8xl mx-auto px-4 sm:px-4 md:px-8 lg:px-16 xl:px-32">
        <h2 class="text-5xl font-black text-center mb-16">
          The Hidden Cost of Being
          <span class="text-skin-accent">'Just a Developer'</span>
        </h2>

        <div class="grid md:grid-cols-2 gap-16 items-center">
          <!-- Image Column (Now First) -->
          <div class="relative">
            <!-- Decorative Background Shapes -->
            <div class="absolute -bottom-12 -right-12 w-64 h-64 rotate-45 bg-skin-card/30 rounded-[30%_70%_70%_30%/30%_30%_70%_70%] z-0"></div>
            <div class="absolute -top-12 -left-12 w-48 h-48 -rotate-12 bg-skin-card/30 rounded-[30%_70%_70%_30%/30%_30%_70%_70%] z-0"></div>
            
            <!-- Image Container -->
            <div class="relative rounded-3xl border-2 border-dashed border-skin-accent p-4 bg-skin-fill shadow-lg z-[1]">
              <img 
                src="/dev-career-missed-opportunities.png" 
                alt="Developer Career Missed Opportunities Visualization" 
                class="w-full h-auto rounded-2xl"
              />
            </div>
          </div>

          <!-- Text Column (Now Second) -->
          <div class="space-y-6">
            <p class="text-xl leading-relaxed">
              For the first half of my career, I was leaving massive
              opportunities on the table.
              <span class="text-skin-accent font-semibold"
                >Like most developers, I was:</span
              >
            </p>

            <div class="space-y-4 relative">
              <div class="absolute w-0.5 bg-skin-accent h-full left-3 top-0">
              </div>

              <div
                class="relative pl-12 py-2 transition-all hover:translate-x-2 duration-200"
              >
                <div
                  class="absolute left-0 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full border-2 border-skin-accent bg-skin-fill"
                >
                </div>
                <p class="text-lg">
                  Stuck in the implementation loop - writing code but not
                  building real leverage
                </p>
              </div>

              <div
                class="relative pl-12 py-2 transition-all hover:translate-x-2 duration-200"
              >
                <div
                  class="absolute left-0 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full border-2 border-skin-accent bg-skin-fill"
                >
                </div>
                <p class="text-lg">
                  Watching opportunities pass by while staying in my comfort
                  zone
                </p>
              </div>

              <div
                class="relative pl-12 py-2 transition-all hover:translate-x-2 duration-200"
              >
                <div
                  class="absolute left-0 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full border-2 border-skin-accent bg-skin-fill"
                >
                </div>
                <p class="text-lg">
                  Struggling to turn my knowledge into tangible career growth
                </p>
              </div>

              <div
                class="relative pl-12 py-2 transition-all hover:translate-x-2 duration-200"
              >
                <div
                  class="absolute left-0 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full border-2 border-skin-accent bg-skin-fill"
                >
                </div>
                <p class="text-lg">
                  Missing the signs of bigger possibilities right in front of me
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <WaveDivider rotate height="lg" marginBottom={-15} />

    <!-- The Turning Point Section -->
    <section
      class="relative overflow-hidden w-full max-w-full py-0 bg-skin-card/30"
    >
      <div class="max-w-8xl mx-auto px-4 sm:px-4 md:px-8 lg:px-16 xl:px-32">
        <div class="grid md:grid-cols-2 gap-16 items-center">
          <div class="space-y-6">
            <h2 class="text-5xl font-black">
              The Turning Point:
              <span class="block mt-4 text-3xl font-medium text-skin-accent">
                When Everything Changed
              </span>
            </h2>

            <p class="text-xl leading-relaxed">
              Then I discovered something powerful. I started piecing together
              elements of what would become the FABRIC system. Even with just
              fragments of this approach:
            </p>

            <div class="space-y-4 relative">
              <div class="absolute w-0.5 bg-skin-accent h-full left-3 top-0">
              </div>

              <div
                class="relative pl-12 py-2 transition-all hover:translate-x-2 duration-200"
              >
                <div
                  class="absolute left-0 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full border-2 border-skin-accent bg-skin-fill"
                >
                </div>
                <p class="text-lg">
                  Successfully navigated immigration from South Africa to New
                  Zealand
                </p>
              </div>

              <div
                class="relative pl-12 py-2 transition-all hover:translate-x-2 duration-200"
              >
                <div
                  class="absolute left-0 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full border-2 border-skin-accent bg-skin-fill"
                >
                </div>
                <p class="text-lg">
                  Transformed from needing two incomes to thriving on one
                </p>
              </div>

              <div
                class="relative pl-12 py-2 transition-all hover:translate-x-2 duration-200"
              >
                <div
                  class="absolute left-0 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full border-2 border-skin-accent bg-skin-fill"
                >
                </div>
                <p class="text-lg">
                  Grew our family from one child to three while increasing our
                  quality of life
                </p>
              </div>

              <div
                class="relative pl-12 py-2 transition-all hover:translate-x-2 duration-200"
              >
                <div
                  class="absolute left-0 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full border-2 border-skin-accent bg-skin-fill"
                >
                </div>
                <p class="text-lg">
                  Built career opportunities I never thought possible
                </p>
              </div>
            </div>
          </div>

          <!-- Right Column (Timeline) -->
          <div class="relative">
            <!-- Blob Container with fixed size -->
            <div class="absolute inset-0 overflow-visible">
              <!-- Blob SVG Background -->
              <svg 
                viewBox="0 0 200 200" 
                class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[1000px] h-[800px] rotate-[75deg] origin-center
                       md:scale-100 sm:scale-125 scale-150"
                preserveAspectRatio="none"
              >
                <path 
                  d="M47.5,-57.2C59.9,-47.3,67.3,-30.9,70.8,-13.5C74.2,4,73.6,22.5,65.2,36.6C56.8,50.7,40.5,60.4,23.2,64.7C5.8,69,-12.6,67.9,-30.4,62.1C-48.2,56.2,-65.4,45.6,-71.6,30.2C-77.8,14.8,-73,-5.4,-64.6,-22.1C-56.2,-38.8,-44.2,-52,-30.1,-61.1C-16,-70.2,0.2,-75.2,14.8,-71.1C29.5,-67,35.2,-67.1,47.5,-57.2Z" 
                  transform="translate(100 100)"
                  class="fill-skin-fill stroke-skin-accent stroke-2"
                />
              </svg>
            </div>

            <!-- Content Container -->
            <div class="relative p-8 md:p-12">
              <!-- Timeline Container -->
              <div class="relative pb-20">
                <!-- Center Timeline Line -->
                <div class="absolute left-1/2 top-0 bottom-16 w-1 bg-skin-accent -translate-x-1/2" />
                <div 
                  class="absolute left-1/2 top-0 bottom-16 w-1 -translate-x-1/2" 
                  style="background: linear-gradient(180deg, transparent 0%, var(--color-accent) 20%, var(--color-accent) 100%);"
                />
                
                <!-- Milestones -->
                <div class="relative space-y-2">
                  {[
                    { 
                      year: 2014,
                      event: "Career Pivot",
                      salary: 28000,
                      details: "Agency → Startup",
                      icon: "briefcase",
                      column: 'left'
                    },
                    { 
                      year: 2016,
                      event: "Mind Shift",
                      salary: 38000,
                      details: "Lead Frontend Eng.",
                      icon: "trending-up",
                      column: 'right'
                    },
                    { 
                      year: 2018,
                      event: "Family Begins",
                      salary: 48000,
                      details: "First child",
                      icon: "baby",
                      column: 'left'
                    },
                    { 
                      year: 2020,
                      event: "Remote NZ Role",
                      salary: 115000,
                      details: "International opportunity",
                      icon: "trending-up",
                      column: 'right'
                    },
                    { 
                      year: 2022,
                      event: "Major Changes",
                      salary: 130000,
                      details: "Immigration + Second child",
                      icon: "plane",
                      column: 'left'
                    },
                    { 
                      year: 2023,
                      event: "Corporate Role",
                      salary: 140000,
                      details: "Full Stack Position",
                      icon: "briefcase",
                      column: 'right'
                    },
                    { 
                      year: 2024,
                      event: "AI Startup",
                      salary: 160000,
                      details: "Third child + New Role",
                      icon: "trending-up",
                      column: 'left'
                    }
                  ].map((milestone, index, array) => (
                    <div class="flex items-center h-16">
                      <!-- Left Content -->
                      <div class={`flex-1 ${milestone.column === 'left' ? 'block' : 'invisible'}`}>
                        <div class="pr-8 text-right">
                          <div class="text-sm opacity-60">{milestone.year}</div>
                          <div class="font-semibold leading-tight">{milestone.event}</div>
                          <div>
                            <span class="text-lg font-bold leading-none text-skin-accent">${(milestone.salary/1000).toFixed(0)}k</span>
                            <div class="text-sm opacity-60 leading-tight">{milestone.details}</div>
                            {index > 0 && (
                              <div class="text-sm text-emerald-500 leading-none">
                                +${((milestone.salary - array[index-1].salary)/1000).toFixed(0)}k
                              </div>
                            )}
                          </div>
                        </div>
                      </div>

                      <!-- Center Icon -->
                      <div class="relative z-10">
                        <div class={`w-12 h-12 rounded-full flex items-center justify-center
                          bg-skin-fill border-4 border-skin-accent`}>
                          {milestone.icon === 'briefcase' && <Briefcase className="w-5 h-5 text-skin-accent" client:load />}
                          {milestone.icon === 'trending-up' && <TrendingUp className="w-5 h-5 text-skin-accent" client:load />}
                          {milestone.icon === 'baby' && <Baby className="w-5 h-5 text-skin-accent" client:load />}
                          {milestone.icon === 'plane' && <Plane className="w-5 h-5 text-skin-accent" client:load />}
                        </div>
                      </div>

                      <!-- Right Content -->
                      <div class={`flex-1 ${milestone.column === 'right' ? 'block' : 'invisible'}`}>
                        <div class="pl-8">
                          <div class="text-sm opacity-60">{milestone.year}</div>
                          <div class="font-semibold leading-tight">{milestone.event}</div>
                          <div>
                            <span class="text-lg font-bold leading-none text-skin-accent">${(milestone.salary/1000).toFixed(0)}k</span>
                            <div class="text-sm opacity-60 leading-tight">{milestone.details}</div>
                            {index > 0 && (
                              <div class="text-sm text-emerald-500 leading-none">
                                +${((milestone.salary - array[index-1].salary)/1000).toFixed(0)}k
                              </div>
                            )}
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- System Progress Indicator -->
            <div class="relative z-20 text-center mb-8 -top-16">
              <div class="inline-flex items-center gap-2 px-4 py-2 bg-skin-accent/10 rounded-full">
                <span class="text-sm text-skin-accent">Partial FABRIC System</span>
                <ArrowRight className="w-4 h-4 text-skin-accent" client:load />
                <span class="text-sm font-semibold text-skin-accent">Full System</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <WaveDivider height="lg" marginBottom={-25} />

    <!-- The FABRIC System Section -->
    <section class="relative overflow-hidden w-full max-w-full py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-4 md:px-8 lg:px-16 xl:px-32">
        <div class="text-center max-w-4xl mx-auto mb-16">
          <h2 class="text-5xl font-black mb-6">
            The FABRIC System:
            <span class="block mt-4 text-skin-accent">A Complete Framework</span
            >
          </h2>
          <p class="text-xl">
            I've now refined these scattered pieces into a systematic approach
            that helps you:
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="group relative">
            <div
              class="absolute inset-0.5 bg-linear-to-br/srgb from-skin-accent to-transparent opacity-5 blur-2xl group-hover:opacity-10 transition-opacity rounded-3xl"
            >
            </div>
            <div
              class="relative p-8 rounded-3xl border-2 border-dashed border-skin-accent bg-skin-fill h-full"
            >
              <h3 class="text-2xl font-bold mb-4 text-skin-accent">
                Turn Knowledge Into Power
              </h3>
              <p class="text-lg">
                Turn everyday learning into career-defining opportunities
              </p>
            </div>
          </div>

          <div class="group relative">
            <div
              class="absolute inset-0.5 bg-linear-to-br/srgb from-skin-accent to-transparent opacity-5 blur-2xl group-hover:opacity-10 transition-opacity rounded-3xl"
            >
            </div>
            <div
              class="relative p-8 rounded-3xl border-2 border-dashed border-skin-accent bg-skin-fill h-full"
            >
              <h3 class="text-2xl font-bold mb-4 text-skin-accent">
                Automated Success
              </h3>
              <p class="text-lg">
                Build systems that create "luck" while you sleep
              </p>
            </div>
          </div>

          <div class="group relative">
            <div
              class="absolute inset-0.5 bg-linear-to-br/srgb from-skin-accent to-transparent opacity-5 blur-2xl group-hover:opacity-10 transition-opacity rounded-3xl"
            >
            </div>
            <div
              class="relative p-8 rounded-3xl border-2 border-dashed border-skin-accent bg-skin-fill h-full"
            >
              <h3 class="text-2xl font-bold mb-4 text-skin-accent">
                Spot Opportunities
              </h3>
              <p class="text-lg">Identify high-leverage moments others miss</p>
            </div>
          </div>

          <div class="group relative">
            <div
              class="absolute inset-0.5 bg-linear-to-br/srgb from-skin-accent to-transparent opacity-5 blur-2xl group-hover:opacity-10 transition-opacity rounded-3xl"
            >
            </div>
            <div
              class="relative p-8 rounded-3xl border-2 border-dashed border-skin-accent bg-skin-fill h-full"
            >
              <h3 class="text-2xl font-bold mb-4 text-skin-accent">
                Transform Knowledge
              </h3>
              <p class="text-lg">Transform knowledge into tangible outcomes</p>
            </div>
          </div>

          <div class="group md:col-span-2">
            <div
              class="absolute inset-0.5 bg-linear-to-br/srgb from-skin-accent to-transparent opacity-5 blur-2xl group-hover:opacity-10 transition-opacity rounded-3xl"
            >
            </div>
            <div
              class="relative p-8 rounded-3xl border-2 border-dashed border-skin-accent bg-skin-fill h-full"
            >
              <h3 class="text-2xl font-bold mb-4 text-skin-accent">
                Unstoppable Momentum
              </h3>
              <p class="text-lg">
                Create unstoppable career momentum through systematic growth and
                opportunity capture
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <WaveDivider rotate />

    <!-- What You Get Section -->
    <section
      class="relative overflow-hidden w-full max-w-full py-24 bg-skin-card/30"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-4 md:px-8 lg:px-16 xl:px-32">
        <div class="text-center max-w-4xl mx-auto mb-16">
          <h2 class="text-5xl font-black mb-6">What You Get</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-16">
          <!-- Email Course Card -->
          <div class="relative">
            <div
              class="rounded-3xl border-2 border-dashed border-skin-accent p-8 bg-skin-fill h-full"
            >
              <div
                class="absolute -top-4 left-8 px-4 py-1 bg-skin-accent text-skin-inverted rounded-full text-sm font-bold"
              >
                CORE PROGRAM
              </div>
              <h3 class="text-3xl font-black mb-6 text-skin-accent">
                6-Part Email Course
              </h3>
              <p class="text-xl mb-8">Master the complete FABRIC framework</p>

              <ul class="space-y-4">
                <li class="flex items-start gap-3">
                  <Check
                    className="w-6 h-6 mt-1 text-skin-accent shrink-0"
                    client:only="react"
                  />
                  <span
                    >Define your ideal future and map the path to get there</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <Check
                    className="w-6 h-6 mt-1 text-skin-accent shrink-0"
                    client:only="react"
                  />
                  <span
                    >Build systems for capturing and leveraging everything you
                    learn</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <Check
                    className="w-6 h-6 mt-1 text-skin-accent shrink-0"
                    client:only="react"
                  />
                  <span>Create feedback loops that accelerate your growth</span>
                </li>
                <li class="flex items-start gap-3">
                  <Check
                    className="w-6 h-6 mt-1 text-skin-accent shrink-0"
                    client:only="react"
                  />
                  <span
                    >Transform your knowledge into opportunities and influence</span
                  >
                </li>
              </ul>
            </div>
          </div>

          <!-- Bonuses Card -->
          <div class="relative">
            <div
              class="rounded-3xl border-2 border-dashed border-skin-accent p-8 bg-skin-fill h-full"
            >
              <div
                class="absolute -top-4 left-8 px-4 py-1 bg-skin-accent text-skin-inverted rounded-full text-sm font-bold"
              >
                EXCLUSIVE BONUSES
              </div>
              <h3 class="text-3xl font-black mb-6 text-skin-accent">
                Bonus Resources
              </h3>
              <p class="text-xl mb-8">
                Additional tools for faster implementation
              </p>

              <ul class="space-y-4">
                <li class="flex items-start gap-3">
                  <div
                    class="w-6 h-6 mt-1 rounded-full bg-skin-accent/10 flex items-center justify-center shrink-0"
                  >
                    <span class="text-skin-accent font-bold">1</span>
                  </div>
                  <span
                    >Quick-start Guide: The "Opportunity Spotter" checklist</span
                  >
                </li>
                <li class="flex items-start gap-3">
                  <div
                    class="w-6 h-6 mt-1 rounded-full bg-skin-accent/10 flex items-center justify-center shrink-0"
                  >
                    <span class="text-skin-accent font-bold">2</span>
                  </div>
                  <span
                    >Framework for identifying high-leverage moments in tech</span
                  >
                </li>
