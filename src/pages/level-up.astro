<script src="https://cdn.jsdelivr.net/npm/confetti-js@0.0.18/dist/index.min.js"
></script>

<script is:inline>
  // Wait for libraries to load
  window.addEventListener("load", () => {
    // Wait for toast to be available
    const checkToast = setInterval(() => {
      if (window.toast) {
        clearInterval(checkToast);
        initializeForm();
      }
    }, 100);

    function initializeForm() {
      // Create confetti instance with optimized settings
      const confettiSettings = {
        target: "confetti-canvas",
        max: 40,
        size: 1,
        animate: true,
        props: ["circle", "square", "triangle"],
        colors: [
          [255, 198, 30],
          [165, 104, 246],
          [45, 175, 230],
        ],
        clock: 25,
        rotate: true,
        respawn: false,
        origin: { y: 0.7 },
      };

      // Handle form submission for both forms
      function setupForm(formId, submitBtnId, spinnerId) {
        const form = document.getElementById(formId);
        const submitBtn = document.getElementById(submitBtnId);
        const spinner = document.getElementById(spinnerId);
        const btnText = submitBtn?.querySelector("span");

        async function handleSubmit(e) {
          e.preventDefault();
          if (!form || !submitBtn || !spinner || !btnText) return;

          const emailInput = form.querySelector(
            `#${formId === "signup-form" ? "email" : "email-bottom"}`
          );
          const firstNameInput = form.querySelector(
            `#${formId === "signup-form" ? "firstName" : "firstName-bottom"}`
          );
          const email = emailInput ? emailInput.value : "";
          const firstName = firstNameInput ? firstNameInput.value : "";

          // Show loading state
          spinner.classList.remove("hidden");
          btnText.textContent = "Subscribing...";
          submitBtn.disabled = true;

          try {
            const response = await fetch("/api/subscribe", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                email: email.trim(),
                firstName: firstName.trim(),
              }),
            });

            console.log("Client response:", response.status);

            let data;
            try {
              const text = await response.text();
              data = JSON.parse(text);
            } catch (e) {
              console.error("Failed to parse response:", e);
              throw new Error("Invalid server response");
            }

            if (!response.ok) {
              throw new Error(data.error || "Subscription failed");
            }

            // Success state
            let canvas = document.getElementById("confetti-canvas");
            if (!canvas) {
              canvas = document.createElement("canvas");
              canvas.id = "confetti-canvas";
              canvas.className = "fixed pointer-events-none inset-0 z-50";
              canvas.style.opacity = "0.8";
              document.body.appendChild(canvas);
            }

            // Get button position
            const buttonRect = submitBtn.getBoundingClientRect();
            const buttonCenterX = (buttonRect.left + buttonRect.right) / 2;
            const origin = {
              x: buttonCenterX / window.innerWidth,
              y: buttonRect.top / window.innerHeight,
            };

            const confetti = new window.ConfettiGenerator({
              ...confettiSettings,
              origin,
            });

            confetti.render();
            setTimeout(() => {
              confetti.clear();
            }, 2000);

            window.toast.success(
              "🎉 You're in! Check your inbox for the Obsidian template.",
              {
                duration: 5000,
                position: "bottom-center",
              }
            );

            // Reset both forms on success
            document.getElementById("signup-form").reset();
            document.getElementById("signup-form-bottom").reset();
          } catch (error) {
            console.error("Form submission error:", error);
            window.toast.error(
              error instanceof Error
                ? error.message
                : "Something went wrong. Please try again.",
              {
                duration: 5000,
                position: "bottom-center",
              }
            );
          } finally {
            // Reset button state
            spinner.classList.add("hidden");
            btnText.textContent =
              formId === "signup-form"
                ? "Get the Free Template"
                : "Start Your Journey";
            submitBtn.disabled = false;
          }
        }

        form?.addEventListener("submit", handleSubmit);
      }

      // Setup both forms
      setupForm("signup-form", "submit-btn", "spinner");
      setupForm("signup-form-bottom", "submit-btn-bottom", "spinner-bottom");
    }
  });
</script>

<canvas id="confetti-canvas" class="fixed pointer-events-none inset-0 z-50"
></canvas>

<div id="toast-container"></div>

<style>
  #confetti-canvas {
    opacity: 0.8;
  }
</style>
