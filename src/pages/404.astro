---
import { ArrowLeft, Home } from "lucide-react";
import GardenLayout from "@layouts/GardenLayout.astro";
---

<GardenLayout
  title="404 Not Found"
  description="The requested page could not be found."
  pageType="utility"
>
  <main
    id="main-content"
    class="utility-page"
    transition:animate="none"
    tabindex="-1"
  >
    <div class="utility-card">
      <p class="utility-code" aria-hidden="true">404</p>
      <h1>Page not found</h1>
      <p>The page you followed isn’t available in this garden.</p>
      <nav aria-label="Continue browsing">
        <a href="/"><Home size={15} aria-hidden="true" /> Go home</a>
        <a href="/garden"
          ><ArrowLeft size={15} aria-hidden="true" /> Browse the garden</a
        >
      </nav>
    </div>
  </main>
</GardenLayout>
