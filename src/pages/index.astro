---
import { ArrowRight, Mail } from "lucide-react";
import GardenLayout from "@layouts/GardenLayout.astro";
import ActivityFeed from "@components/garden/ActivityFeed.astro";
import EntryPoints from "@components/garden/EntryPoints.astro";
import Newsletter from "@components/garden/Newsletter.astro";
import ThemeImage from "@components/garden/ThemeImage.astro";
import { SOCIALS } from "@config";
import { getPublicCatalogue } from "../lib/public-catalogue";
const catalogue = await getPublicCatalogue();
const contact =
  SOCIALS.find(social => social.name === "Mail")?.href ?? "/about";
const latest = catalogue.activity[0];
---

<GardenLayout pageType="home">
  <header class="garden-home-intro">
    <h1 data-typing-heading>Notes on software and life.</h1>
    <p>
      I’m MJ, a product engineer with about twenty years building for the web.<br
        class="garden-desktop-break"
      /> Exploring AI without losing the craft.
    </p>
    <div class="garden-mobile-contact">
      <a href="/about">About &amp; experience</a><a href={contact}
        >Get in touch</a
      >
    </div>
  </header>
  <div class="garden-mobile-paths">
    <span>Explore the garden</span>
    <EntryPoints entries={catalogue.entryPoints} compact />
    <button type="button" data-newsletter-open aria-haspopup="dialog"
      ><strong>Terminally Curious</strong><small>The garden, by email</small
      ><ArrowRight size={13} aria-hidden="true" /></button
    >
  </div>
  <main
    id="main-content"
    class="garden-home-layout"
    transition:animate="none"
    tabindex="-1"
  >
    <div class="garden-home-reading">
      <section class="garden-home-start" aria-labelledby="garden-start-title">
        <h2 id="garden-start-title">Start here</h2>
        <p>
          Four broad themes connect my notes: what I’m learning, working toward,
          and thinking about.
        </p>
        <EntryPoints entries={catalogue.entryPoints} />
      </section>
      <ActivityFeed items={catalogue.activity} />
    </div>
    <aside
      class="garden-home-rail"
      aria-label="Author, garden entry points and newsletter"
    >
      <div class="garden-person">
        <ThemeImage
          dark="/profile-dark.png"
          light="/profile-light.png"
          alt="Illustrated portrait of MJ Meyer"
          width={70}
          height={74}
        /><div><h2>MJ Meyer</h2><p>Product engineer</p></div>
      </div>
      <div class="garden-person-links">
        <a href="/about"
          >About &amp; experience <ArrowRight
            size={13}
            strokeWidth={1.5}
            aria-hidden="true"
          /></a
        ><a href={contact}
          >Get in touch <Mail
            size={14}
            strokeWidth={1.5}
            aria-hidden="true"
          /></a
        >
      </div>
      <section class="garden-rail-paths">
        <h2>Explore the garden</h2><EntryPoints
          entries={catalogue.entryPoints}
          compact
        />
      </section>
      <Newsletter
        latestTitle={latest?.title}
        latestUrl={latest?.url}
        latestDescription={latest?.description}
      />
    </aside>
  </main>
</GardenLayout>
