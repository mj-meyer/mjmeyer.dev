---
import DiscoveryIndex from "@components/garden/DiscoveryIndex.astro";
import {
  getPublicCatalogue,
  type StreamType,
} from "../../lib/public-catalogue";
import { SITE } from "@config";

export async function getStaticPaths() {
  const catalogue = await getPublicCatalogue();
  const pageCount = Math.ceil(catalogue.stream.length / SITE.postPerPage);
  const types = [
    ...new Set(catalogue.stream.flatMap(item => item.streamType ?? [])),
  ];
  return [
    ...Array.from({ length: pageCount }, (_, index) => ({
      params: { slug: String(index + 1) },
    })),
    ...types.map(type => ({ params: { slug: type } })),
  ];
}

const catalogue = await getPublicCatalogue();
const slug = Astro.params.slug ?? "1";
const streamTypes = [
  ...new Set(catalogue.stream.flatMap(item => item.streamType ?? [])),
].sort();
const type = streamTypes.includes(slug as StreamType)
  ? (slug as StreamType)
  : undefined;
const totalPages = Math.ceil(catalogue.stream.length / SITE.postPerPage);
const page = type ? undefined : Number(slug);
if (
  !type &&
  (!Number.isInteger(page) || !page || page < 1 || page > totalPages)
)
  return Astro.redirect("/404");
const typeItems = type
  ? catalogue.stream.filter(item => item.streamType === type)
  : undefined;
const items = type
  ? catalogue.stream
  : catalogue.stream.slice(
      ((page ?? 1) - 1) * SITE.postPerPage,
      (page ?? 1) * SITE.postPerPage
    );
const typeOptions = streamTypes.map(value => ({
  value,
  label: value[0].toUpperCase() + value.slice(1),
}));
const heading = type
  ? `${type[0].toUpperCase() + type.slice(1)} stream`
  : "Stream";
const description = type
  ? `Published ${type} resources collected from around the web.`
  : "A numbered view of useful resources collected from around the web.";
---

<DiscoveryIndex
  title={type ? `${heading} resources` : `Digital Stream — Page ${page}`}
  heading={heading}
  description={description}
  items={items}
  allItems={catalogue.items}
  active="stream"
  sidebar="stream"
  itemNoun="resource"
  itemPlural="resources"
  publishedTotal={typeItems?.length ?? catalogue.stream.length}
  initialVisibleCount={typeItems?.length ?? items.length}
  filterLabel="Resource type"
  filterParam="type"
  filterOptions={typeOptions}
  defaultFilter={type ?? "all"}
  contextNote={type ? undefined : `Page ${page} of ${totalPages}.`}
  pagination={page
    ? { current: page, total: totalPages, basePath: "/stream" }
    : undefined}
  emptyBrowseHref="/stream"
  emptyBrowseLabel="Browse all stream notes"
/>
