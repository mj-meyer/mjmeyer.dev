---
import DiscoveryIndex from "@components/garden/DiscoveryIndex.astro";
import { SITE } from "@config";
import { getPublicCatalogue } from "../../lib/public-catalogue";

const catalogue = await getPublicCatalogue();
const types = [
  ...new Set(catalogue.stream.flatMap(item => item.streamType ?? [])),
]
  .sort()
  .map(value => ({ value, label: value[0].toUpperCase() + value.slice(1) }));
---

<DiscoveryIndex
  title="Digital Stream of Resources"
  heading="Stream"
  description="Content I’ve collected from around the web that supports what I’m learning and is worth revisiting or sharing."
  items={catalogue.stream}
  allItems={catalogue.items}
  active="stream"
  sidebar="stream"
  itemNoun="resource"
  itemPlural="resources"
  publishedTotal={catalogue.stream.length}
  filterLabel="Resource type"
  filterParam="type"
  filterOptions={types}
  defaultFilter="all"
  contextNote="Think of this as a durable stream of useful references rather than an ephemeral social feed."
  emptyBrowseHref="/stream"
  emptyBrowseLabel="Browse all stream notes"
  pagination={{
    total: Math.max(1, Math.ceil(catalogue.stream.length / SITE.postPerPage)),
    basePath: "/stream",
    label: "Three-at-a-time pages",
  }}
/>
