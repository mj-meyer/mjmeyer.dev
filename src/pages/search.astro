---
import DiscoveryIndex from "@components/garden/DiscoveryIndex.astro";
import { getPublicCatalogue } from "../lib/public-catalogue";

const catalogue = await getPublicCatalogue();
const kinds = [
  { value: "garden", label: "Garden notes" },
  { value: "stream", label: "Stream notes" },
] as const;
---

<DiscoveryIndex
  title="Search"
  heading="Search"
  description="Search published garden and stream notes by title, description, or topic."
  items={catalogue.items}
  allItems={catalogue.items}
  sidebar="search"
  itemNoun="result"
  itemPlural="results"
  publishedTotal={catalogue.items.length}
  filterLabel="Collection"
  filterParam="kind"
  filterOptions={kinds}
  defaultFilter="all"
  emptyTitle="No matching published notes"
  emptyDescription="Try a broader phrase or clear the collection filter."
  emptyBrowseHref="/garden"
  emptyBrowseLabel="Browse the garden"
/>
