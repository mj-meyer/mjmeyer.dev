---
import DiscoveryIndex from "@components/garden/DiscoveryIndex.astro";
import { getPublicCatalogue } from "../../lib/public-catalogue";
import { transformTag } from "@utils/tagUtils";

export async function getStaticPaths() {
  const catalogue = await getPublicCatalogue();
  const topics = new Map<string, string>();
  for (const item of catalogue.items)
    for (const tag of item.tags) {
      const { slug, display } = transformTag(tag);
      topics.set(slug, display);
    }
  return [...topics].map(([slug, display]) => ({
    params: { topic: slug },
    props: { display },
  }));
}

const slug = Astro.params.topic ?? "";
const { display } = Astro.props as { display: string };
const catalogue = await getPublicCatalogue();
const items = catalogue.items.filter(item =>
  item.tags.some(tag => transformTag(tag).slug === slug)
);
if (!items.length) return Astro.redirect("/404");
const kinds = [
  { value: "garden", label: "Garden notes" },
  { value: "stream", label: "Stream notes" },
] as const;
---

<DiscoveryIndex
  title={`${display} Notes`}
  heading={display}
  description={`Published garden and stream notes tagged ${display}.`}
  items={items}
  allItems={catalogue.items}
  active="garden"
  sidebar="topics"
  itemNoun="note"
  itemPlural="notes"
  publishedTotal={items.length}
  filterLabel="Collection"
  filterParam="kind"
  filterOptions={kinds}
  defaultFilter="all"
  contextNote="Back to the complete topic directory for another label."
  emptyBrowseHref="/topics"
  emptyBrowseLabel="Browse all topics"
/>
