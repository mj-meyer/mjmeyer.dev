---
import TopicDirectory from "@components/garden/TopicDirectory.astro";
import { getPublicCatalogue } from "../../lib/public-catalogue";
import { transformTag } from "@utils/tagUtils";

const catalogue = await getPublicCatalogue();
const topics = new Map<
  string,
  {
    slug: string;
    display: string;
    count: number;
    gardenCount: number;
    streamCount: number;
  }
>();
for (const item of catalogue.items) {
  for (const tag of item.tags) {
    const { slug, display } = transformTag(tag);
    const topic = topics.get(slug) ?? {
      slug,
      display,
      count: 0,
      gardenCount: 0,
      streamCount: 0,
    };
    topic.count++;
    if (item.kind === "garden") topic.gardenCount++;
    else topic.streamCount++;
    topics.set(slug, topic);
  }
}
const summaries = [...topics.values()].sort((a, b) =>
  a.display.localeCompare(b.display)
);
---

<TopicDirectory topics={summaries} allItems={catalogue.items} />
