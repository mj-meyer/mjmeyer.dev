---
import { ArrowLeft, Home, Sprout } from "lucide-react";
import GardenLayout from "@layouts/GardenLayout.astro";
---

<GardenLayout
  title="Note unavailable"
  description="This garden note is not publicly available."
  pageType="utility"
  active="garden"
>
  <main
    id="main-content"
    class="utility-page"
    transition:animate="none"
    tabindex="-1"
  >
    <div class="utility-card" data-unpublished-page>
      <Sprout size={72} strokeWidth={1.25} aria-hidden="true" />
      <p class="personal-eyebrow">The garden has boundaries</p>
      <h1>Note unavailable</h1>
      <p class="utility-note-name" data-unpublished-name hidden></p>
      <p>
        This link points to an unwritten or unpublished note. There isn’t a
        public page for it.
      </p>
      <nav aria-label="Continue reading">
        <a href="/garden"
          ><ArrowLeft size={15} aria-hidden="true" /> Browse the garden</a
        >
        <a href="/"><Home size={15} aria-hidden="true" /> Go home</a>
      </nav>
    </div>
  </main>
</GardenLayout>
