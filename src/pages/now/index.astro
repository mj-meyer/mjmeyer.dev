---
import { getCollection } from "astro:content";
import NowSnapshot from "@components/garden/NowSnapshot.astro";

const posts = (await getCollection("now", ({ data }) => !data.draft)).toSorted(
  (a, b) => b.data.publishDatetime.getTime() - a.data.publishDatetime.getTime()
);
const latest = posts[0];
if (!latest) throw new Error("The Now archive has no published snapshots");
---

<NowSnapshot post={latest} archive={posts} isLatest />
