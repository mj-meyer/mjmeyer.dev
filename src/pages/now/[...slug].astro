---
import { getCollection, type CollectionEntry } from "astro:content";
import NowSnapshot from "@components/garden/NowSnapshot.astro";

interface Props {
  post: CollectionEntry<"now">;
  archive: CollectionEntry<"now">[];
}

export async function getStaticPaths() {
  const posts = (
    await getCollection("now", ({ data }) => !data.draft)
  ).toSorted(
    (a, b) =>
      b.data.publishDatetime.getTime() - a.data.publishDatetime.getTime()
  );

  return posts.map(post => {
    const [year, month] = post.id.split("-");
    return {
      params: { slug: `${year}/${month}` },
      props: { post, archive: posts },
    };
  });
}

const { post, archive } = Astro.props;
---

<NowSnapshot post={post} archive={archive} />
