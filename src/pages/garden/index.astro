---
import DiscoveryIndex from "@components/garden/DiscoveryIndex.astro";
import { SITE } from "@config";
import { getPublicCatalogue } from "../../lib/public-catalogue";

const catalogue = await getPublicCatalogue();
const stages = [
  { value: "seedling", label: "Seedling" },
  { value: "budding", label: "Budding" },
  { value: "evergreen", label: "Evergreen" },
] as const;
---

<DiscoveryIndex
  title="Digital Garden Notes"
  heading="Garden"
  description="Notes on software and life. Follow a question, explore a connection, or see what’s been growing."
  items={catalogue.garden}
  allItems={catalogue.items}
  active="garden"
  sidebar="garden"
  itemNoun="note"
  itemPlural="notes"
  publishedTotal={catalogue.garden.length}
  filterLabel="Growth stage"
  filterParam="stage"
  filterOptions={stages}
  defaultFilter="all"
  pagination={{
    total: Math.max(1, Math.ceil(catalogue.garden.length / SITE.postPerPage)),
    basePath: "/garden",
    label: "Three-at-a-time pages",
  }}
/>
