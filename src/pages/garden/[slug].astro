---
import DiscoveryIndex from "@components/garden/DiscoveryIndex.astro";
import {
  getPublicCatalogue,
  type GardenState,
} from "../../lib/public-catalogue";
import { SITE } from "@config";

const stages = [
  { value: "seedling", label: "Seedling" },
  { value: "budding", label: "Budding" },
  { value: "evergreen", label: "Evergreen" },
] as const;
const stageDescriptions: Record<GardenState, string> = {
  seedling:
    "Early thoughts and useful atomic notes that may evolve quickly as they take root.",
  budding:
    "Developing notes supported by other ideas, open to revision as their context grows.",
  evergreen:
    "Durable notes held with confidence and still open to careful growth over time.",
};

export async function getStaticPaths() {
  const catalogue = await getPublicCatalogue();
  const pageCount = Math.ceil(catalogue.garden.length / SITE.postPerPage);
  const stageValues = ["seedling", "budding", "evergreen"];
  return [
    ...Array.from({ length: pageCount }, (_, index) => ({
      params: { slug: String(index + 1) },
    })),
    ...stageValues.map(stage => ({ params: { slug: stage } })),
  ];
}

const catalogue = await getPublicCatalogue();
const slug = Astro.params.slug ?? "1";
const stage = stages.some(option => option.value === slug)
  ? (slug as GardenState)
  : undefined;
const totalPages = Math.ceil(catalogue.garden.length / SITE.postPerPage);
const page = stage ? undefined : Number(slug);
if (
  !stage &&
  (!Number.isInteger(page) || !page || page < 1 || page > totalPages)
)
  return Astro.redirect("/404");
const stageItems = stage
  ? catalogue.garden.filter(item => item.state === stage)
  : undefined;
const items = stage
  ? catalogue.garden
  : catalogue.garden.slice(
      ((page ?? 1) - 1) * SITE.postPerPage,
      (page ?? 1) * SITE.postPerPage
    );
const heading = stage
  ? `${stages.find(option => option.value === stage)?.label} notes`
  : "Garden";
const description = stage
  ? stageDescriptions[stage]
  : "My always growing and evolving thoughts, notes and ideas.";
const contextNote = stage ? undefined : `Page ${page} of ${totalPages}.`;
---

<DiscoveryIndex
  title={stage
    ? `${heading} | Digital Garden`
    : `Digital Garden Notes — Page ${page}`}
  heading={heading}
  description={description}
  items={items}
  allItems={catalogue.items}
  active="garden"
  sidebar="garden"
  itemNoun="note"
  itemPlural="notes"
  publishedTotal={stageItems?.length ?? catalogue.garden.length}
  initialVisibleCount={stageItems?.length ?? items.length}
  filterLabel="Growth stage"
  filterParam="stage"
  filterOptions={stages}
  defaultFilter={stage ?? "all"}
  contextNote={contextNote}
  pagination={page
    ? { current: page, total: totalPages, basePath: "/garden" }
    : undefined}
  emptyTitle={stage === "evergreen" ? "No evergreen notes yet" : undefined}
  emptyDescription={stage === "evergreen"
    ? "This stage is intentionally empty until a published note reaches it."
    : undefined}
/>
