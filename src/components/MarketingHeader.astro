---
import { Image } from "astro:assets";
import { LOGO_IMAGE, SITE } from "@config";

import logoSVGAlternate from "../assets/logo-alternate.svg";
import logoSVGDefault from "../assets/logo.svg";
---

<header class="z-40 relative pt-16 max-md:pt-5 max-sm:pt-0">
  <a id="skip-to-content" href="#maincontent">Skip to content</a>
  <div class="nav-container">
    <div class="top-nav-wrap">
      <a href="/" class="logo dark" transition:persist>
        {
          LOGO_IMAGE.enable ? (
            <Image
              src={logoSVGDefault}
              alt="MJ Meyer - Logo Dark"
              width={LOGO_IMAGE.width}
              height={LOGO_IMAGE.height}
            />
          ) : (
            SITE.title
          )
        }
      </a>
      <a href="/" class="logo light" transition:persist>
        {
          LOGO_IMAGE.enable ? (
            <Image
              src={logoSVGAlternate}
              alt="MJ Meyer - Logo Light"
              width={LOGO_IMAGE.width}
              height={LOGO_IMAGE.height}
            />
          ) : (
            SITE.title
          )
        }
      </a>
      <nav id="nav-menu">
        <ul id="menu-items" class="font-montserrat font-black hidden md:flex">
          <li>
            {
              SITE.lightAndDarkMode && (
                <button
                  id="theme-btn"
                  class="focus-outline"
                  title="Toggles light & dark"
                  aria-label="auto"
                  aria-live="polite"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" id="moon-svg">
                    <path d="M20.742 13.045a8.088 8.088 0 0 1-2.077.271c-2.135 0-4.14-.83-5.646-2.336a8.025 8.025 0 0 1-2.064-7.723A1 1 0 0 0 9.73 2.034a10.014 10.014 0 0 0-4.489 2.582c-3.898 3.898-3.898 10.243 0 14.143a9.937 9.937 0 0 0 7.072 2.93 9.93 9.93 0 0 0 7.07-2.929 10.007 10.007 0 0 0 2.583-4.491 1.001 1.001 0 0 0-1.224-1.224zm-2.772 4.301a7.947 7.947 0 0 1-5.656 2.343 7.953 7.953 0 0 1-5.658-2.344c-3.118-3.119-3.118-8.195 0-11.314a7.923 7.923 0 0 1 2.06-1.483 10.027 10.027 0 0 0 2.89 7.848 9.972 9.972 0 0 0 7.848 2.891 8.036 8.036 0 0 1-1.484 2.059z" />
                  </svg>
                  <svg xmlns="http://www.w3.org/2000/svg" id="sun-svg">
                    <path d="M6.993 12c0 2.761 2.246 5.007 5.007 5.007s5.007-2.246 5.007-5.007S14.761 6.993 12 6.993 6.993 9.239 6.993 12zM12 8.993c1.658 0 3.007 1.349 3.007 3.007S13.658 15.007 12 15.007 8.993 13.658 8.993 12 10.342 8.993 12 8.993zM10.998 19h2v3h-2zm0-17h2v3h-2zm-9 9h3v2h-3zm17 0h3v2h-3zM4.219 18.363l2.12-2.122 1.415 1.414-2.12 2.122zM16.24 6.344l2.122-2.122 1.414 1.414-2.122 2.122zM6.342 7.759 4.22 5.637l1.415-1.414 2.12 2.122zm13.434 10.605-1.414 1.414-2.122-2.122 1.414-1.414z" />
                  </svg>
                </button>
              )
            }
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  header:before {
    content: "";
    display: block;
    position: absolute;
    top: 7rem;
    left: 0;
    width: 100%;
    height: 4.9rem;
    z-index: 30;
    /* TODO: fix height on all resolutions */
    @apply bg-skin-fill max-sm:h-20 max-md:h-28 max-md:top-12 max-sm:top-6;
  }
  #skip-to-content {
    @apply absolute -top-full left-16 z-50 bg-skin-accent px-3 py-2 text-skin-inverted transition-all focus:top-4;
  }
  .nav-container {
    @apply mx-auto flex max-w-6xl flex-col items-center justify-center md:flex-row;
  }
  .top-nav-wrap {
    @apply relative flex w-full items-center justify-center p-4 max-md:flex-col md:items-center md:py-8;
  }
  .logo {
    @apply flex justify-center text-xl z-50 font-semibold w-full lg:pl-6 xl:pl-0 max-md:w-3/4 max-sm:w-4/6 md:text-2xl;
  }

  .logo img {
    @apply w-2/5;
  }

  nav {
    @apply flex z-50 flex-col items-center md:ml-2 md:flex-row md:justify-end md:space-x-4 md:py-0;
  }
  nav ul {
    @apply mt-16 grid-cols-2 md:flex grid-rows-4 gap-x-2 gap-y-2 md:ml-0 md:mt-0 md:w-auto md:gap-x-8 md:gap-y-0;
  }
  nav ul li {
    @apply col-span-2 flex items-center justify-center;
  }
  nav ul li a {
    @apply w-full px-4 py-3 z-20 text-center text-xl font-medium uppercase text-skin-heading hover:text-skin-accent md:my-0 md:px-4 md:py-1  decoration-violet-500/10 decoration-solid decoration-4 underline-offset-0;
  }
  nav ul li a span {
    @apply absolute -bottom-3 -z-10 bg-skin-card/40 px-3 py-1 whitespace-nowrap left-8 text-left text-xs opacity-80 max-md:hidden;
  }
  nav ul li:nth-child(4) a {
    @apply w-auto;
  }
  nav ul li:nth-child(4),
  nav ul li:nth-child(5) {
    @apply col-span-1;
  }
  nav ul li a.active {
    @apply text-skin-accent font-semibold decoration-solid decoration-8 decoration-current;
  }
  nav a.active svg {
    @apply fill-skin-accent;
  }
  nav ul li a.active span {
    @apply bg-skin-accent text-skin-inverted;
  }

  nav button {
    @apply p-1;
  }
  nav button svg {
    @apply h-6 w-6 fill-skin-base hover:fill-skin-accent;
  }
  #theme-btn {
    @apply p-3 md:p-1;
  }
  #theme-btn svg {
    @apply scale-125 hover:rotate-12 md:scale-100;
  }

  .icon-container {
    @apply h-5 w-6 flex-col items-end justify-between;
  }
  .icon-container div {
    @apply h-0.5 bg-skin-inverted transition-all;
  }
  #first-line {
    @apply w-full;
  }
  #second-line {
    @apply w-3/4;
  }
  #third-line {
    @apply w-1/2;
  }
</style>

<script></script>
